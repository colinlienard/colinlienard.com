---
import { Font } from 'astro:assets';
import Grain from '../components/Grain.astro';
import Nav from '../components/Nav.astro';
import Sunlit from '../components/Sunlit.astro';
import '../global.css';
---

<!doctype html>
<html lang={Astro.currentLocale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>Colin Lienard</title>
		<Font cssVariable="--font-inter" preload />
	</head>
	<body
		class="flex min-h-dvh cursor-default flex-col items-center gap-48 bg-taupe-100 pt-32 font-sans text-taupe-900 antialiased selection:bg-taupe-900/10"
	>
		<Sunlit />
		<Grain />
		<Nav />
		<slot />
	</body>
</html>
