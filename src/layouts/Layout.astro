---
import '../global.css';
import { Font } from 'astro:assets';
import Footer from '../components/Footer.astro';
import Menu from '../components/Menu.astro';
import Seo from '../components/Seo.astro';
---

<!doctype html>
<html lang={Astro.currentLocale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>Colin Lienard</title>
		<Seo />
		<Font cssVariable="--font-inter" preload />
		<Font cssVariable="--font-newsreader" preload />
		<!-- TODO: remove this when done -->
		<meta name="robots" content="noindex, nofollow" />
	</head>
	<body
		class="flex min-h-dvh cursor-default flex-col items-center bg-neutral-50 pt-36 font-sans font-medium text-neutral-900 antialiased selection:bg-neutral-900/10"
	>
		<Menu />
		<main class="flex w-full max-w-[min(calc(100vw-4rem),40rem)] flex-col gap-20">
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		animation: appear 0.3s ease-out;

		@media (prefers-reduced-motion: reduce) {
			animation: none;
		}
	}

	@keyframes appear {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}
</style>
