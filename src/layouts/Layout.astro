---
import '../global.css';
import { Font } from 'astro:assets';
import BlurGradient from '../components/BlurGradient.astro';
import Footer from '../components/Footer.astro';
import Menu from '../components/menu/Menu.astro';
import Seo from '../components/Seo.astro';
---

<!doctype html>
<html lang={Astro.currentLocale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<Seo />
		<Font cssVariable="--font-inter" preload />
		<Font cssVariable="--font-newsreader" preload />
		<script is:inline>
			const theme = localStorage.getItem('theme');
			document.documentElement.classList.toggle(
				'dark',
				theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches),
			);
		</script>
		<!-- TODO: remove this when done -->
		<meta name="robots" content="noindex, nofollow" />
	</head>
	<body
		class="bg-bg text-fg selection:bg-fg/6 flex min-h-dvh cursor-default flex-col items-center pt-36 font-sans font-medium antialiased"
	>
		<Menu />
		<BlurGradient />
		<main class="flex w-full max-w-[min(calc(100vw-4rem),40rem)] flex-col gap-20">
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		animation: appear 0.5s ease-out;

		@media (prefers-reduced-motion: reduce) {
			animation: none;
		}
	}

	@keyframes appear {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}
</style>
