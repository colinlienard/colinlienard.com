---
import '../global.css';
import { Font } from 'astro:assets';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import Seo from '../components/Seo.astro';
import Sunlit from '../components/Sunlit.astro';
---

<!doctype html>
<html lang={Astro.currentLocale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>Colin Lienard</title>
		<Seo />
		<Font cssVariable="--font-inter" preload />
		<Font cssVariable="--font-geist-mono" preload />
		<!-- TODO: remove this when done -->
		<meta name="robots" content="noindex, nofollow" />
	</head>
	<body
		class="flex min-h-dvh cursor-default flex-col items-center gap-40 bg-white pt-32 font-sans text-zinc-900 antialiased selection:bg-zinc-900/10"
	>
		<Sunlit />
		<Nav />
		<main class="contents">
			<slot />
		</main>
		<Footer />
	</body>
</html>
