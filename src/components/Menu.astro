---
import { Image } from 'astro:assets';
import me from '../assets/me.jpeg';
import Menu from './Menu.svelte';
---

<Menu locale={Astro.currentLocale} client:load>
	<Image
		src={me}
		alt="Colin Lienard"
		width={80}
		height={80}
		class="size-10 rounded-full object-cover"
		loading="eager"
	/>
</Menu>
