---
import EmailIcon from 'virtual:icons/heroicons/envelope-solid';
import GithubIcon from 'virtual:icons/logos/github-icon';
import LinkedinIcon from 'virtual:icons/logos/linkedin-icon';
import XIcon from 'virtual:icons/logos/x';
import ArrowUpRightIcon from 'virtual:icons/heroicons/arrow-up-right';
import MaltIcon from '../assets/malt.svg';
import { useTranslations } from '../i18n';

const t = useTranslations(Astro.currentLocale);
---

<section class="section flex flex-col gap-12">
	<h2 class="text-2xl font-medium tracking-tight">{t('contact.title')}</h2>
	<div class="group">
		<button
			type="button"
			id="copy-email-contact"
			data-email="hello@colinlienard.com"
			class="copy-email flex w-full items-center gap-2 py-4 transition-opacity group-hover:opacity-30 hover:opacity-100! [&_path]:fill-taupe-900"
		>
			<EmailIcon />
			<span class="relative">
				<span class="copy-label copy-label-default">{t('hero.cta.secondary')}</span>
				<span class="copy-label copy-label-copied" aria-hidden="true">{t('hero.cta.copied')}</span>
			</span>
		</button>
		<hr class="text-taupe-900/10" />
		<a
			href="https://www.linkedin.com/in/colin-lienard/"
			target="_blank"
			rel="noopener noreferrer"
			class="flex items-center gap-2 py-4 transition-opacity group-hover:opacity-30 hover:opacity-100! [&_path]:fill-taupe-900"
		>
			<LinkedinIcon />
			LinkedIn
			<ArrowUpRightIcon class="ml-auto size-4" />
		</a>
		<hr class="text-taupe-900/10" />
		<a
			href="#"
			target="_blank"
			rel="noopener noreferrer"
			class="flex items-center gap-2 py-4 transition-opacity group-hover:opacity-30 hover:opacity-100! [&_path]:fill-taupe-900"
		>
			<MaltIcon />
			Malt
			<ArrowUpRightIcon class="ml-auto size-4" />
		</a>
		<hr class="text-taupe-900/10" />
		<a
			href="https://github.com/colinlienard"
			target="_blank"
			rel="noopener noreferrer"
			class="flex items-center gap-2 py-4 transition-opacity group-hover:opacity-30 hover:opacity-100! [&_path]:fill-taupe-900"
		>
			<GithubIcon />
			GitHub
			<ArrowUpRightIcon class="ml-auto size-4" />
		</a>
		<hr class="text-taupe-900/10" />
		<a
			href="https://x.com/colinlienard"
			target="_blank"
			rel="noopener noreferrer"
			class="flex items-center gap-2 py-4 transition-opacity group-hover:opacity-30 hover:opacity-100! [&_path]:fill-taupe-900"
		>
			<XIcon />
			X
			<ArrowUpRightIcon class="ml-auto size-4" />
		</a>
	</div>
</section>

<script>
	const button = document.querySelector('#copy-email-contact');

	if (button instanceof HTMLButtonElement) {
		const { email } = button.dataset;
		let timeout: ReturnType<typeof setTimeout>;

		button.addEventListener('click', async () => {
			if (!email) return;

			try {
				await navigator.clipboard.writeText(email);
				button.dataset.copied = 'true';
				clearTimeout(timeout);
				timeout = setTimeout(() => {
					delete button.dataset.copied;
				}, 3000);
			} catch {
				location.assign(`mailto:${email}`);
			}
		});
	}
</script>

<style>
	.copy-label {
		transition:
			opacity 0.5s ease,
			filter 0.5s ease;
	}

	.copy-label-copied {
		position: absolute;
		left: 0;
		opacity: 0;
		filter: blur(4px);
	}

	.copy-email[data-copied] .copy-label-default {
		opacity: 0;
		filter: blur(4px);
	}

	.copy-email[data-copied] .copy-label-copied {
		opacity: 1;
		filter: blur(0);
	}
</style>
