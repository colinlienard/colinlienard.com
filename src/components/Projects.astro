---
import { Image } from 'astro:assets';
import IconStar from 'virtual:icons/heroicons/star';
import IconStarSolid from 'virtual:icons/heroicons/star-solid';
import GithubIcon from 'virtual:icons/logos/github-icon';
import githundred from '../assets/githundred.png';
import gitlight from '../assets/gitlight.png';
import svrouter from '../assets/sv-router.svg';
import { CONTACT } from '../config';
import { useTranslations } from '../i18n';

const t = useTranslations(Astro.currentLocale);

const projects = [
	{
		title: 'sv-router',
		image: svrouter,
		description: 'Type-safe routing for Svelte SPAs',
		stars: 200,
		link: 'https://github.com/colinlienard/sv-router',
	},
	{
		title: 'GitLight',
		image: gitlight,
		description: 'GitHub & GitLab notifications on your desktop',
		stars: 900,
		link: 'https://github.com/colinlienard/gitlight',
	},
	{
		title: 'GitHundred',
		image: githundred,
		description: 'Top 100 most starred GitHub repositories',
		stars: 50,
		link: 'https://githundred.vercel.app',
	},
];
---

<section id="projects" class="section flex scroll-mt-24 flex-col gap-12">
	<!-- <h2 class="text-2xl font-medium tracking-tight">{t('projects.title')}</h2> -->
	<div class="flex items-center gap-2">
		<IconStar class="[&_path]:stroke-2" />
		<h2 class="">{t('projects.title')}</h2>
	</div>
	<ul class="group grid border-[0.5px] border-taupe-900/10 sm:grid-cols-2">
		{
			projects.map((project) => (
				<li class="border-[0.5px] border-taupe-900/10">
					<a
						href={project.link}
						target="_blank"
						rel="noopener noreferrer"
						class="flex flex-col items-center gap-8 p-8 transition-all group-hover:grayscale hover:grayscale-0! hover:[&_img]:scale-110"
					>
						<div class="flex w-full items-center justify-end gap-1">
							<IconStarSolid class="text-amber-400" />
							<span class="font-mono text-sm text-taupe-900/60">+{project.stars}</span>
						</div>
						<div class="relative">
							<Image
								src={project.image}
								alt={project.title}
								width={256}
								height={256}
								class="relative z-10 size-32 transition-transform"
								loading="lazy"
							/>
						</div>
						<div class="flex w-full flex-col gap-2">
							<span class="font-semibold">{project.title}</span>
							<span class="text-sm text-taupe-900/60">{project.description}</span>
						</div>
					</a>
				</li>
			))
		}
		<li class="flex min-h-32 items-center justify-center border-[0.5px] border-taupe-900/10">
			<p class="text-taupe-900/60">
				{t('projects.moreOn')}{' '}
				<a href={CONTACT.github} target="_blank" rel="noopener noreferrer" class="underline">
					<GithubIcon class="mr-1 inline size-4 -translate-y-px [&_path]:fill-taupe-900/60" />
					GitHub</a
				>.
			</p>
		</li>
	</ul>
</section>
