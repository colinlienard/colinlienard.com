---
import { useTranslations } from '../i18n';
import IconStar from 'virtual:icons/heroicons/star-solid';
import svrouter from '../assets/sv-router.svg';
import gitlight from '../assets/gitlight.png';
import { Image } from 'astro:assets';

const t = useTranslations(Astro.currentLocale);

const projects = [
	{
		title: 'sv-router',
		image: svrouter,
		description: 'Type-safe routing for Svelte SPAs',
		stars: 200,
		link: 'https://github.com/colinlienard/sv-router',
	},
	{
		title: 'GitLight',
		image: gitlight,
		description: 'GitHub & GitLab notifications on your desktop',
		stars: 900,
		link: 'https://github.com/colinlienard/gitlight',
	},
];
---

<section class="section flex flex-col gap-12">
	<h2 class="text-2xl font-medium tracking-tight">{t('projects.title')}</h2>
	<ul class="grid grid-cols-2 border border-taupe-900/10">
		{
			projects.map((project) => (
				<li class="border-l border-taupe-900/10 first:border-none">
					<a
						href={project.link}
						target="_blank"
						rel="noopener noreferrer"
						class="flex flex-col items-center gap-8 p-8"
					>
						<div class="flex w-full items-center justify-end gap-1">
							<IconStar class="text-amber-400" />
							<span class="text-sm text-taupe-900/60">+{project.stars}</span>
						</div>
						<div class="relative">
							<Image
								src={project.image}
								alt={project.title}
								width={256}
								height={256}
								class="relative z-10 size-32"
								loading="lazy"
							/>
							<Image
								src={project.image}
								alt={project.title}
								width={256}
								height={256}
								class="absolute top-0 size-32 blur-3xl"
								loading="lazy"
							/>
						</div>
						<div class="flex w-full flex-col gap-2">
							<span class="font-semibold">{project.title}</span>
							<span class="text-sm text-taupe-900/60">{project.description}</span>
						</div>
					</a>
				</li>
			))
		}
	</ul>
	<p class="text-sm text-taupe-900/60">
		{t('projects.moreOn')}{' '}
		<a
			href="https://github.com/colinlienard"
			target="_blank"
			rel="noopener noreferrer"
			class="underline">GitHub</a
		>.
	</p>
</section>
