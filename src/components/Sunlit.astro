<canvas class="sunlit" aria-hidden="true"></canvas>

<script>
	const CONFIG = {
		render: {
			dprCap: 1.5, // max device-pixel-ratio (lower = faster, blurrier)
			fieldScale: 0.6, // field pass resolution vs screen (lower = faster)
			mouseEase: 0.04, // mouse follow smoothing (0..1, lower = laggier)
		},
		colors: {
			background: hex('#FBF1E7'), // backdrop
			shadow: hex('#262612'), // shadow tint
		},
		pool: {
			center: [0.6028, 0.6171], // light pool center, UV space (y up)
			radius: 0.177, // light pool size
			skew: [0.54, 0.46], // pool stretch (x, y)
			mouseShift: 0.15, // how far the pool follows the mouse
		},
		cells: {
			scale: 26.7, // voronoi density (higher = smaller leaf cells)
			rotation: 0.763, // cell field rotation (radians)
			skew: [1.0, 0.16], // cell stretch (x, y)
			displace: 0.2, // how hard cells shatter the field (UV units)
			speed: 0.2, // cell shimmer/morph speed
			timeOffset: 5.0, // phase offset so it doesn't start uniform
		},
		sine: {
			freq: 7.0, // horizontal wave frequency
			amp: 0.236, // wave amplitude
			speed: 0.26, // wave drift speed
		},
		bokeh: {
			samples: 40, // blur quality (higher = smoother, slower)
			radius: 0.436, // blur/bloom size
			bloom: 150.0, // how much bright areas bloom
			bloomPower: 9.0, // bloom contrast (higher = only brightest bloom)
		},
		composite: {
			multiply: 0.48, // strength of the shadow multiply over the backdrop
			parallax: 0.02, // subtle whole-field shift with the mouse
		},
		aberration: {
			amount: 0.008, // chromatic aberration: radial R/B split, grows toward edges
		},
		grain: {
			amount: 0.2, // film grain strength (screen blend mix; 0 = off)
			speed: 0.1, // grain regenerations per second (1 = original; raise to shimmer)
		},
	};

	function glf(n: number) {
		const s = String(n);
		return s.includes('.') || s.includes('e') ? s : s + '.0';
	}

	function glv(a: number[]) {
		return `vec${a.length}(${a.map(glf).join(', ')})`;
	}

	function hex(h: string): number[] {
		const n = parseInt(h.replace('#', ''), 16);
		return [(n >> 16) & 255, (n >> 8) & 255, n & 255].map((c) => Math.round((c / 255) * 1e4) / 1e4);
	}

	const VERT = `#version 300 es
		precision highp float;
		in vec2 aPos;
		out vec2 vUv;
		void main() {
			vUv = aPos * 0.5 + 0.5;
			gl_Position = vec4(aPos, 0.0, 1.0);
		}
	`;

	const FIELD = `#version 300 es
		precision highp float;
		in vec2 vUv;
		out vec4 frag;
		uniform vec2 uRes;
		uniform float uTime;
		uniform vec2 uMouse;

		const float PI = 3.14159265359;
		const float TAU = 6.28318530718;

		mat2 rot(float a) { float s = sin(a), c = cos(a); return mat2(c, -s, s, c); }

		vec2 hash2(vec2 p) {
			return fract(sin(vec2(dot(p, vec2(127.1, 311.7)), dot(p, vec2(269.5, 183.3)))) * 43758.5453);
		}

		// Nearest animated feature point of a voronoi cell.
		vec2 voronoiCell(vec2 st, float t) {
			vec2 g = floor(st), f = fract(st);
			float best = 15.0;
			vec2 bestP = vec2(0.0);
			for (int j = -1; j <= 1; j++)
			for (int i = -1; i <= 1; i++) {
				vec2 nb = vec2(float(i), float(j));
				vec2 p = hash2(g + nb);
				p = 0.5 + 0.5 * sin(t + TAU * p);
				vec2 d = nb + p - f;
				float dd = dot(d, d);
				if (dd < best) { best = dd; bestP = p; }
			}
			return bestP;
		}

		vec2 voronoiFbm(vec2 st, float t) {
			vec2 v = vec2(0.0);
			mat2 r = rot(0.5);
			for (int i = 0; i < 2; i++) {
				v += voronoiCell(st, t);
				st = st * 1.41421356 + 100.0;
				st = r * st;
			}
			return v * 0.5;
		}

		// Radial light pool (bright) fading to shadow, offset toward the mouse.
		vec3 lightField(vec2 uv) {
			float aspect = uRes.x / uRes.y;
			vec2 asp = vec2(aspect, 1.0);
			vec2 skew = ${glv(CONFIG.pool.skew)};
			float halfR = ${glf(CONFIG.pool.radius)};
			float inner = halfR * 0.5;
			float outer = halfR * 1.5;
			vec2 pos = ${glv(CONFIG.pool.center)} + (uMouse - 0.5) * ${glf(CONFIG.pool.mouseShift)};
			float radius = distance(uv * asp * skew, pos * asp * skew);
			float f = smoothstep(inner, outer, radius);
			return mix(vec3(1.0), ${glv(CONFIG.colors.shadow)}, f);
		}

		vec2 sineDistort(vec2 uv, float t) {
			vec2 w = uv * 2.0 - 1.0;
			w.x += sin((w.y + 0.5) * ${glf(CONFIG.sine.freq)} + t) * ${glf(CONFIG.sine.amp)};
			return w * 0.5 + 0.5;
		}

		vec2 shatterDistort(vec2 uv, float t) {
			float aspect = uRes.x / uRes.y;
			vec2 st = (uv - 0.5) * vec2(aspect, 1.0) * ${glf(CONFIG.cells.scale)};
			st = rot(${glf(CONFIG.cells.rotation)}) * st;
			st *= ${glv(CONFIG.cells.skew)};
			vec2 p = voronoiFbm(st, t);
			vec2 offset = p * ${glf(CONFIG.cells.displace * 2)} - ${glf(CONFIG.cells.displace)};
			return uv + offset;
		}

		void main() {
			vec2 uv = vUv;
			uv = shatterDistort(uv, ${glf(CONFIG.cells.timeOffset)} + uTime * ${glf(CONFIG.cells.speed)});
			uv = sineDistort(uv, uTime * ${glf(CONFIG.sine.speed)});
			frag = vec4(lightField(uv), 1.0);
		}
	`;

	const COMPOSITE = `#version 300 es
		precision highp float;
		in vec2 vUv;
		out vec4 frag;
		uniform sampler2D uField;
		uniform vec2 uRes;
		uniform float uTime;
		uniform vec2 uMouse;

		const float TAU = 6.28318530718;
		const int SAMPLES = ${CONFIG.bokeh.samples};
		const float GOLDEN_ANGLE = 2.39996323;

		float gradientNoise(vec2 p) {
			return fract(52.9829189 * fract(dot(p, vec2(0.06711056, 0.00583715))));
		}

		// PCG 2D hash (Jarzynski & Olano) — clean, uniform white noise for grain.
		uvec2 pcg2d(uvec2 v) {
			v = v * 1664525u + 1013904223u;
			v.x += v.y * 1664525u;
			v.y += v.x * 1664525u;
			v ^= v >> 16u;
			v.x += v.y * 1664525u;
			v.y += v.x * 1664525u;
			v ^= v >> 16u;
			return v;
		}

		float grainNoise(vec2 p) {
			uvec2 v = pcg2d(floatBitsToUint(p));
			return float(v.x ^ v.y) / float(0xffffffffu);
		}

		// Golden-angle disc sampling, weighting bright samples so they bloom.
		// Per sample, R/B are nudged radially apart for chromatic aberration on
		// the light patches (visible only where channels differ = patch edges).
		vec3 bokeh(vec2 uv) {
			float aspect = uRes.x / uRes.y;
			vec2 px = vec2(1.0 / aspect, 1.0) * ${glf(CONFIG.bokeh.radius)} * 0.075;
			vec2 caOff = (uv - 0.5) * vec2(aspect, 1.0) * ${glf(CONFIG.aberration.amount)};
			float n = gradientNoise(gl_FragCoord.xy);
			float ang = n * TAU;
			vec3 col = vec3(0.0);
			vec3 wsum = vec3(0.0);
			for (int i = 0; i < SAMPLES; i++) {
				float r = sqrt((float(i) + 0.5 + n) / float(SAMPLES));
				vec2 base = uv + vec2(cos(ang), sin(ang)) * r * px;
				vec3 s = vec3(
					texture(uField, base + caOff).r,
					texture(uField, base).g,
					texture(uField, base - caOff).b
				);
				vec3 w = vec3(5.0) + pow(s, vec3(${glf(CONFIG.bokeh.bloomPower)})) * ${glf(CONFIG.bokeh.bloom)};
				col += s * w;
				wsum += w;
				ang += GOLDEN_ANGLE;
			}
			return col / wsum;
		}

		void main() {
			vec2 uv = vUv + (uMouse - 0.5) * ${glf(CONFIG.composite.parallax)};
			vec3 field = bokeh(uv);

			vec3 grey = ${glv(CONFIG.colors.background)};
			vec3 col = mix(grey, field * grey, ${glf(CONFIG.composite.multiply)});

			${
				CONFIG.grain.amount > 0
					? `
			float delta = fract(floor(uTime * ${glf(CONFIG.grain.speed)}) / 20.0);
			float g = grainNoise(gl_FragCoord.xy + delta);
			vec3 screen = 1.0 - (1.0 - vec3(g)) * (1.0 - col);
			col = mix(col, screen, ${glf(CONFIG.grain.amount)});`
					: '// grain disabled'
			}

			frag = vec4(col, 1.0);
		}
	`;

	function compile(gl: WebGL2RenderingContext, type: number, src: string) {
		const sh = gl.createShader(type)!;
		gl.shaderSource(sh, src.trim());
		gl.compileShader(sh);
		if (!gl.getShaderParameter(sh, gl.COMPILE_STATUS)) {
			console.error(gl.getShaderInfoLog(sh));
		}
		return sh;
	}

	function program(gl: WebGL2RenderingContext, vert: string, frag: string) {
		const p = gl.createProgram()!;
		gl.attachShader(p, compile(gl, gl.VERTEX_SHADER, vert));
		gl.attachShader(p, compile(gl, gl.FRAGMENT_SHADER, frag));
		gl.bindAttribLocation(p, 0, 'aPos');
		gl.linkProgram(p);
		if (!gl.getProgramParameter(p, gl.LINK_STATUS)) {
			console.error(gl.getProgramInfoLog(p));
		}
		return p;
	}

	function init(canvas: HTMLCanvasElement) {
		const gl = canvas.getContext('webgl2', { antialias: false, alpha: false });
		if (!gl) return;

		const fieldProg = program(gl, VERT, FIELD);
		const compProg = program(gl, VERT, COMPOSITE);

		const vao = gl.createVertexArray();
		gl.bindVertexArray(vao);
		const vbo = gl.createBuffer();
		gl.bindBuffer(gl.ARRAY_BUFFER, vbo);
		gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
		gl.enableVertexAttribArray(0);
		gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 0, 0);

		const fieldTex = gl.createTexture();
		gl.bindTexture(gl.TEXTURE_2D, fieldTex);
		gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
		gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
		gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
		gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
		const fbo = gl.createFramebuffer();
		gl.bindFramebuffer(gl.FRAMEBUFFER, fbo);
		gl.framebufferTexture2D(gl.FRAMEBUFFER, gl.COLOR_ATTACHMENT0, gl.TEXTURE_2D, fieldTex, 0);

		const u = (p: WebGLProgram, name: string) => gl.getUniformLocation(p, name);
		const loc = {
			fRes: u(fieldProg, 'uRes'),
			fTime: u(fieldProg, 'uTime'),
			fMouse: u(fieldProg, 'uMouse'),
			cField: u(compProg, 'uField'),
			cRes: u(compProg, 'uRes'),
			cTime: u(compProg, 'uTime'),
			cMouse: u(compProg, 'uMouse'),
		};

		let W = 0;
		let H = 0;
		let fW = 0;
		let fH = 0;

		function resize() {
			if (!gl) return;
			const dpr = Math.min(window.devicePixelRatio || 1, CONFIG.render.dprCap);
			W = Math.round(window.innerWidth * dpr);
			H = Math.round(window.innerHeight * dpr);
			fW = Math.max(1, Math.round(W * CONFIG.render.fieldScale));
			fH = Math.max(1, Math.round(H * CONFIG.render.fieldScale));
			canvas.width = W;
			canvas.height = H;
			gl.bindTexture(gl.TEXTURE_2D, fieldTex);
			gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, fW, fH, 0, gl.RGBA, gl.UNSIGNED_BYTE, null);
		}
		resize();
		window.addEventListener('resize', resize);

		const mouse = { x: 0.5, y: 0.5 };
		const target = { x: 0.5, y: 0.5 };
		window.addEventListener(
			'pointermove',
			(e) => {
				target.x = e.clientX / window.innerWidth;
				target.y = 1 - e.clientY / window.innerHeight;
			},
			{ passive: true },
		);

		let raf = 0;
		const start = performance.now();

		function render(now: number) {
			if (!gl) return;
			const t = (now - start) / 1000;
			mouse.x += (target.x - mouse.x) * CONFIG.render.mouseEase;
			mouse.y += (target.y - mouse.y) * CONFIG.render.mouseEase;

			// Pass 1: field → low-res framebuffer.
			gl.bindFramebuffer(gl.FRAMEBUFFER, fbo);
			gl.viewport(0, 0, fW, fH);
			gl.useProgram(fieldProg);
			gl.uniform2f(loc.fRes, fW, fH);
			gl.uniform1f(loc.fTime, t);
			gl.uniform2f(loc.fMouse, mouse.x, mouse.y);
			gl.drawArrays(gl.TRIANGLES, 0, 3);

			// Pass 2: bokeh + composite → screen.
			gl.bindFramebuffer(gl.FRAMEBUFFER, null);
			gl.viewport(0, 0, W, H);
			gl.useProgram(compProg);
			gl.activeTexture(gl.TEXTURE0);
			gl.bindTexture(gl.TEXTURE_2D, fieldTex);
			gl.uniform1i(loc.cField, 0);
			gl.uniform2f(loc.cRes, W, H);
			gl.uniform1f(loc.cTime, t);
			gl.uniform2f(loc.cMouse, mouse.x, mouse.y);
			gl.drawArrays(gl.TRIANGLES, 0, 3);

			raf = requestAnimationFrame(render);
		}

		function play() {
			if (!raf) raf = requestAnimationFrame(render);
		}
		function pause() {
			cancelAnimationFrame(raf);
			raf = 0;
		}
		document.addEventListener('visibilitychange', () => (document.hidden ? pause() : play()));
		play();
	}

	const canvas = document.querySelector<HTMLCanvasElement>('canvas.sunlit');
	if (canvas && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		init(canvas);
	}
</script>

<style>
	.sunlit {
		pointer-events: none;
		position: fixed;
		inset: 0;
		height: 100vh;
		width: 100vw;
		display: block;
		z-index: 100;
		mix-blend-mode: multiply;

		@media (prefers-reduced-motion: reduce) {
			display: none;
		}
	}
</style>
