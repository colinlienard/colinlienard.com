---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getLang, languages } from '../i18n';

const lang = getLang(Astro.currentLocale);
---

<nav
	class="fixed top-0 z-10 flex w-full items-center justify-between px-6 py-6 font-medium sm:px-10 sm:py-8"
>
	<a href={getRelativeLocaleUrl(lang, '/')}>Colin Lienard</a>
	<select class="outline-none" aria-label="Switch language" data-lang-switcher>
		{
			Object.entries(languages).map(([code, { label, path }]) => (
				<option value={path} selected={code === lang}>
					{label}
				</option>
			))
		}
	</select>
</nav>

<script>
	const switcher = document.querySelector<HTMLSelectElement>('[data-lang-switcher]');
	switcher?.addEventListener('change', () => {
		location.assign(switcher.value);
	});
</script>
