---
import GithubIcon from 'virtual:icons/logos/github-icon';
import { CONTACT } from '../config';
import { useTranslations } from '../i18n';

const t = useTranslations(Astro.currentLocale);
---

<footer class="section flex flex-col items-center gap-4 pt-24 pb-8 text-sm text-muted">
	<a
		class="flex items-center gap-2 underline decoration-fg/20 underline-offset-4 transition-colors hover:text-fg"
		href={CONTACT.github + '/colinlienard.com'}
		target="_blank"
		rel="noopener noreferrer"
	>
		<GithubIcon class="[&_path]:fill-current" />
		{t('footer.sourceCode')}
	</a>
	<span class="text-center text-balance">
		© Copyright {new Date().getFullYear()} - {t('footer.allRightsReserved')}, Colin Lienard
	</span>
</footer>
