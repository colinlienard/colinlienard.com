---
import { Image } from 'astro:assets';
import StarIcon from 'virtual:icons/heroicons/star';
import StarSolidIcon from 'virtual:icons/heroicons/star-solid';
import GithubIcon from 'virtual:icons/logos/github-icon';
import githundred from '../assets/githundred.png';
import gitlight from '../assets/gitlight.png';
import svrouter from '../assets/sv-router.svg';
import { CONTACT } from '../config';
import { useTranslations } from '../i18n';

const t = useTranslations(Astro.currentLocale);

const projects = [
	{
		title: 'sv-router',
		image: svrouter,
		description: 'Type-safe routing for Svelte single-page apps',
		stars: 200,
		link: 'https://github.com/colinlienard/sv-router',
	},
	{
		title: 'GitLight',
		image: gitlight,
		description: 'GitHub & GitLab notifications on your desktop',
		stars: 900,
		link: 'https://github.com/colinlienard/gitlight',
	},
	{
		title: 'GitHundred',
		image: githundred,
		description: 'Top 100 most starred GitHub repositories',
		stars: 50,
		link: 'https://githundred.vercel.app',
	},
];
---

<section id="projects" class="section flex scroll-mt-24 flex-col gap-12">
	<div class="flex items-center gap-2">
		<StarIcon class="bold-icon" />
		<h2 class="">{t('projects.title')}</h2>
	</div>
	<ul class="group grid gap-4 sm:grid-cols-2">
		{
			projects.map((project) => (
				<li>
					<a
						href={project.link}
						target="_blank"
						rel="noopener noreferrer"
						class="squircle bg-fg/2 flex flex-col items-center gap-8 p-8 transition-all group-hover:grayscale hover:grayscale-0! active:scale-95 hover:[&_img]:scale-110"
					>
						<div class="flex w-full items-center justify-end gap-1">
							<StarSolidIcon class="text-yellow-500" />
							<span class="text-muted text-sm">+{project.stars}</span>
						</div>
						<div class="relative">
							<Image
								src={project.image}
								alt=""
								width={256}
								height={256}
								class="relative z-10 size-32 transition-transform"
								loading="lazy"
							/>
							<Image
								src={project.image}
								alt=""
								width={256}
								height={256}
								class="absolute inset-0 size-32 blur-3xl dark:opacity-75"
								loading="lazy"
								aria-hidden="true"
							/>
						</div>
						<div class="flex w-full flex-col gap-2">
							<h3 class="font-semibold">{project.title}</h3>
							<span class="text-muted text-sm">{project.description}</span>
						</div>
					</a>
				</li>
			))
		}
		<li>
			<a
				href={CONTACT.github}
				target="_blank"
				rel="noopener noreferrer"
				class="squircle text-muted hover:text-fg bg-fg/2 flex h-full items-center justify-center p-8 transition-all active:scale-95"
			>
				<span>
					{t('projects.moreOn')}{' '}
					<span class="decoration-fg/20 underline underline-offset-4">
						<GithubIcon class="mr-1 inline size-4 -translate-y-px [&_path]:fill-current" />
						GitHub
					</span>
				</span>
			</a>
		</li>
	</ul>
</section>
