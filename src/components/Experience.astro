---
import { Image } from 'astro:assets';
import BriefcaseIcon from 'virtual:icons/heroicons/briefcase';
import connivence from '../assets/connivence.png';
import mobsuccess from '../assets/mobsuccess.png';
import { useTranslations } from '../i18n';
import { getStackItem, type StackItem } from '../stack';

type Experience = {
	name: string;
	logo: typeof mobsuccess;
	period: string;
	role: string;
	bullets: { text: string; tooltip?: string }[];
	stack: StackItem[];
};

const t = useTranslations(Astro.currentLocale);

const experiences: Experience[] = [
	{
		name: 'Mobsuccess',
		logo: mobsuccess,
		period: t('experience.mobsuccess.period'),
		role: t('experience.mobsuccess.role'),
		bullets: [
			{ text: t('experience.mobsuccess.b1') },
			{ text: t('experience.mobsuccess.b2') },
			{ text: t('experience.mobsuccess.b3'), tooltip: t('experience.mobsuccess.b3.tooltip') },
			{ text: t('experience.mobsuccess.b4'), tooltip: t('experience.mobsuccess.b4.tooltip') },
			{ text: t('experience.mobsuccess.b5') },
		],
		stack: ['typescript', 'react', 'pandacss', 'testing', 'amplify'],
	},
	{
		name: 'Connivence',
		logo: connivence,
		period: t('experience.connivence.period'),
		role: t('experience.connivence.role'),
		bullets: [{ text: t('experience.connivence.b1') }],
		stack: ['react', 'git', 'figma'],
	},
];
---

<section id="experience" class="section flex scroll-mt-24 flex-col gap-12">
	<div class="flex items-center gap-2">
		<BriefcaseIcon class="[&_path]:stroke-2" />
		<h2 class="">{t('experience.title')}</h2>
	</div>
	<ul class="flex flex-col gap-12">
		{
			experiences.map((experience) => (
				<li class="flex flex-col gap-2">
					<p class="text-sm text-neutral-500">{experience.period}</p>
					<h3 class="inline items-center">
						{experience.role}
						<Image
							src={experience.logo}
							alt={experience.name}
							width={48}
							height={48}
							class="mr-0.5 ml-2 inline size-6 -translate-y-0.5 object-contain"
							loading="lazy"
						/>
						{experience.name}
					</h3>
					<ul class="mt-2 flex list-[circle] flex-col gap-1 pl-4 leading-relaxed text-pretty text-neutral-500">
						{experience.bullets.map((bullet) => (
							<li>
								{'tooltip' in bullet && bullet.tooltip ? (
									<span
										class="tooltip-trigger cursor-help underline decoration-neutral-300 decoration-dashed underline-offset-4"
										tabindex="0"
									>
										{bullet.text}
										<span
											role="tooltip"
											class="tooltip squircle pointer-events-none absolute bottom-[calc(100%+8px)] left-0 z-20 w-max max-w-xs rounded-3xl bg-neutral-900 px-3 py-2 text-sm leading-snug text-white shadow-xl/30"
										>
											{bullet.tooltip}
										</span>
									</span>
								) : (
									bullet.text
								)}
							</li>
						))}
					</ul>
					<ul class="mt-2 flex flex-wrap gap-2">
						{experience.stack.map((item) => {
							const stack = getStackItem(item);
							return (
								<li class="squircle flex items-center gap-1 border border-neutral-200 px-2 py-1 text-sm text-neutral-500">
									<stack.icon class="size-4" />
									{stack.name}
								</li>
							);
						})}
					</ul>
				</li>
			))
		}
	</ul>
</section>

<style>
	.tooltip-trigger {
		position: relative;
	}

	.tooltip {
		opacity: 0;
		transform: translateY(4px);
		transition:
			opacity 0.2s ease,
			transform 0.2s ease;
	}

	.tooltip-trigger:hover .tooltip,
	.tooltip-trigger:focus-visible .tooltip {
		opacity: 1;
		transform: translateY(0);
	}
</style>
