---
import { Image } from 'astro:assets';
import connivence from '../assets/connivence.png';
import mobsuccess from '../assets/mobsuccess.png';
import { useTranslations } from '../i18n';

const t = useTranslations(Astro.currentLocale);

const experiences = [
	{
		name: 'Mobsuccess',
		logo: mobsuccess,
		period: t('experience.mobsuccess.period'),
		role: t('experience.mobsuccess.role'),
		description: t('experience.mobsuccess.description'),
	},
	{
		name: 'Connivence',
		logo: connivence,
		period: t('experience.connivence.period'),
		role: t('experience.connivence.role'),
		description: t('experience.connivence.description'),
	},
];
---

<section class="section flex flex-col gap-12">
	<h2 class="text-2xl font-medium tracking-tight">{t('experience.title')}</h2>
	<ul class="grid gap-10 sm:grid-cols-[auto_1fr] sm:gap-12">
		{
			experiences.map((experience) => (
				<li class="flex flex-col gap-2 sm:contents">
					<p class="font-mono text-sm text-taupe-900/60">{experience.period}</p>
					<div class="flex flex-col gap-3">
						<h3 class="inline items-center font-semibold">
							{experience.role}
							<Image
								src={experience.logo}
								alt={experience.name}
								width={48}
								height={48}
								class="mr-0.5 ml-2 inline size-6 -translate-y-0.5 object-contain"
								loading="eager"
							/>
							{experience.name}
						</h3>
						<p class="leading-relaxed text-pretty whitespace-pre-wrap text-taupe-900/60">
							{experience.description}
						</p>
					</div>
				</li>
			))
		}
	</ul>
</section>
