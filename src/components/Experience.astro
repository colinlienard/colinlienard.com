---
import { Image } from 'astro:assets';
import connivence from '../assets/connivence.png';
import mobsuccess from '../assets/mobsuccess.png';
import { useTranslations } from '../i18n';

const t = useTranslations(Astro.currentLocale);

const experiences = [
	{
		name: 'Mobsuccess',
		logo: mobsuccess,
		period: t('experience.mobsuccess.period'),
		role: t('experience.mobsuccess.role'),
		bullets: [
			{ text: t('experience.mobsuccess.b1') },
			{ text: t('experience.mobsuccess.b2'), tooltip: t('experience.mobsuccess.b2.tooltip') },
			{ text: t('experience.mobsuccess.b3'), tooltip: t('experience.mobsuccess.b3.tooltip') },
			{ text: t('experience.mobsuccess.b4') },
		],
	},
	{
		name: 'Connivence',
		logo: connivence,
		period: t('experience.connivence.period'),
		role: t('experience.connivence.role'),
		bullets: [{ text: t('experience.connivence.b1') }],
	},
];
---

<section class="section flex flex-col gap-12">
	<h2 class="text-2xl font-medium tracking-tight">{t('experience.title')}</h2>
	<ul class="grid gap-10 sm:grid-cols-[auto_1fr] sm:gap-12">
		{
			experiences.map((experience) => (
				<li class="flex flex-col gap-2 sm:contents">
					<p class="font-mono text-sm text-taupe-900/60">{experience.period}</p>
					<div class="flex flex-col gap-3">
						<h3 class="inline items-center font-semibold">
							{experience.role}
							<Image
								src={experience.logo}
								alt={experience.name}
								width={48}
								height={48}
								class="mr-0.5 ml-2 inline size-6 -translate-y-0.5 object-contain"
								loading="lazy"
							/>
							{experience.name}
						</h3>
						<ul class="flex list-disc flex-col gap-1 pl-5 leading-relaxed text-pretty text-taupe-900/60">
							{experience.bullets.map((bullet) => (
								<li>
									{'tooltip' in bullet && bullet.tooltip ? (
										<span
											class="tooltip-trigger cursor-help underline decoration-taupe-900/30 decoration-dashed underline-offset-4"
											tabindex="0"
										>
											{bullet.text}
											<span
												role="tooltip"
												class="tooltip squircle pointer-events-none absolute bottom-[calc(100%+8px)] left-0 z-20 w-max max-w-xs rounded-3xl bg-taupe-900 px-3 py-2 text-sm leading-snug text-white shadow-xl/30"
											>
												{bullet.tooltip}
											</span>
										</span>
									) : (
										bullet.text
									)}
								</li>
							))}
						</ul>
					</div>
				</li>
			))
		}
	</ul>
</section>

<style>
	.tooltip-trigger {
		position: relative;
	}

	.tooltip {
		opacity: 0;
		transform: translateY(4px);
		transition:
			opacity 0.2s ease,
			transform 0.2s ease;
	}

	.tooltip-trigger:hover .tooltip,
	.tooltip-trigger:focus-visible .tooltip {
		opacity: 1;
		transform: translateY(0);
	}
</style>
