---
import { useTranslations } from '../i18n';

const t = useTranslations(Astro.currentLocale);

const experiences = [
	{
		name: 'Mobsuccess',
		logo: '/mobsuccess.png',
		period: t('experience.mobsuccess.period'),
		role: t('experience.mobsuccess.role'),
		description: t('experience.mobsuccess.description'),
	},
	{
		name: 'Connivence',
		logo: '/connivence.png',
		period: t('experience.connivence.period'),
		role: t('experience.connivence.role'),
		description: t('experience.connivence.description'),
	},
];
---

<section class="section flex flex-col gap-16 py-24">
	<h2 class="text-2xl font-medium tracking-tight">{t('experience.title')}</h2>
	<div class="flex flex-col gap-16">
		{
			experiences.map((experience) => (
				<div class="flex flex-col gap-4 sm:flex-row sm:gap-16">
					<p class="w-56 shrink-0 text-sm text-taupe-900/40">{experience.period}</p>
					<div class="flex flex-col gap-3">
						<h3 class="flex items-center gap-2 font-semibold">
							{experience.role}
							<img
								src={experience.logo}
								alt={experience.name}
								class="size-5 rounded object-contain"
							/>
							{experience.name}
						</h3>
						<p class="leading-relaxed text-pretty text-taupe-900/60">{experience.description}</p>
					</div>
				</div>
			))
		}
	</div>
</section>
