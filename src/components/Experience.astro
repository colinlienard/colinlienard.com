---
import { Image } from 'astro:assets';
import { useTranslations } from '../i18n';
import mobsuccess from '../assets/mobsuccess.png';
import connivence from '../assets/connivence.png';

const t = useTranslations(Astro.currentLocale);

const experiences = [
	{
		name: 'Mobsuccess',
		logo: mobsuccess,
		period: t('experience.mobsuccess.period'),
		role: t('experience.mobsuccess.role'),
		description: t('experience.mobsuccess.description'),
	},
	{
		name: 'Connivence',
		logo: connivence,
		period: t('experience.connivence.period'),
		role: t('experience.connivence.role'),
		description: t('experience.connivence.description'),
	},
];
---

<section class="section flex flex-col gap-12">
	<h2 class="text-2xl font-medium tracking-tight">{t('experience.title')}</h2>
	<ul class="grid gap-12 sm:grid-cols-[auto_1fr]">
		{
			experiences.map((experience) => (
				<li class="contents">
					<p class="text-sm text-taupe-900/40">{experience.period}</p>
					<div class="mt-4 flex flex-col gap-3 sm:mt-0">
						<h3 class="flex items-center gap-1 font-semibold">
							{experience.role}
							<Image
								src={experience.logo}
								alt={experience.name}
								width={48}
								height={48}
								class="size-6 translate-x-0.5 object-contain"
								loading="eager"
							/>
							{experience.name}
						</h3>
						<p class="leading-relaxed text-pretty whitespace-pre-wrap text-taupe-900/60">
							{experience.description}
						</p>
					</div>
				</li>
			))
		}
	</ul>
</section>
