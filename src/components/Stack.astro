---
import WrenchScrewdriverIcon from 'virtual:icons/heroicons/wrench-screwdriver';
import { useTranslations } from '../i18n';
import { getStackItem, type StackItem } from '../stack';

const t = useTranslations(Astro.currentLocale);

const items = (
	[
		'typescript',
		'react',
		'svelte',
		'tailwind',
		'node',
		'hono',
		'postgres',
		'docker',
		'cloudflare',
		// 'git',
		// 'cicd',
		'testing',
		'figma',
		'claude',
	] satisfies StackItem[]
).map((item) => getStackItem(item));
---

<section id="stack" class="section flex scroll-mt-24 flex-col gap-12">
	<div class="flex items-center gap-2">
		<WrenchScrewdriverIcon class="[&_path]:stroke-2" />
		<h2 class="">{t('stack.title')}</h2>
	</div>
	<ul
		class="group grid grid-cols-3 justify-center border-[0.5px] border-taupe-900/10 sm:grid-cols-6"
	>
		{
			items.map((item) => (
				<li class="group/item flex aspect-square flex-col items-center justify-center gap-3 border-[0.5px] border-taupe-900/10 hover:[&_svg]:scale-110">
					<item.icon
						class="size-10 transition-all group-hover:grayscale group-hover/item:grayscale-0!"
						aria-hidden="true"
					/>
					<span class="text-xs text-taupe-900/60">{item.name}</span>
				</li>
			))
		}
		<li class="aspect-square border-[0.5px] border-taupe-900/10 sm:hidden"></li>
	</ul>
</section>
