---
import CodeBracketIcon from 'virtual:icons/heroicons/code-bracket';
import { useTranslations } from '../i18n';
import { getStackItem, type StackItem } from '../stack';

const t = useTranslations(Astro.currentLocale);

const items = (
	[
		'typescript',
		'react',
		'svelte',
		'tanstack',
		'pandacss',
		'vitest',
		'hono',
		'postgres',
		'docker',
		'cloudflare',
		'figma',
		'claude',
	] satisfies StackItem[]
).map((item) => getStackItem(item));
---

<section id="stack" class="section flex scroll-mt-24 flex-col gap-12">
	<div class="flex items-center gap-2">
		<CodeBracketIcon class="bold-icon" />
		<h2 class="">{t('stack.title')}</h2>
	</div>
	<ul class="group grid grid-cols-3 justify-center sm:grid-cols-6">
		{
			items.map((item) => (
				<li class="group/item flex aspect-square flex-col items-center justify-center gap-3 hover:[&_svg]:scale-108">
					<item.icon
						class="size-10 transition-all group-hover:grayscale group-hover/item:grayscale-0!"
						aria-hidden="true"
					/>
					<span class="text-muted text-xs">{item.name}</span>
				</li>
			))
		}
	</ul>
</section>
