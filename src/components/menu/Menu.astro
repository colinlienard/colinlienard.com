---
import { Image } from 'astro:assets';
import me from '../../assets/me.jpeg';
import { useTranslations } from '../../i18n';
import type { MenuTranslations } from './menu';
import Menu from './Menu.svelte';

const t = useTranslations(Astro.currentLocale);
const translations: MenuTranslations = {
	role: t('menu.role'),
	available: t('menu.available'),
	location: t('menu.location'),
	sections: t('menu.sections'),
	language: t('menu.language'),
	theme: t('menu.theme'),
	hero: t('hero.title'),
	experience: t('experience.title'),
	projects: t('projects.title'),
	stack: t('stack.title'),
	light: t('menu.light'),
	dark: t('menu.dark'),
	system: t('menu.system'),
};
---

<Menu {translations} client:load>
	<Image
		src={me}
		alt="Colin Lienard"
		width={80}
		height={80}
		class="size-10 shrink-0 rounded-full object-cover"
		loading="eager"
	/>
</Menu>
