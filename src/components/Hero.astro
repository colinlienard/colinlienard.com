---
import { Image } from 'astro:assets';
import me from '../assets/me.jpeg';
import { useTranslations } from '../i18n';
import { getGithubContributions } from '../utils/github-contributions';
import Contacts from './Contacts.svelte';
import CopyEmailButton from './CopyEmailButton.astro';

const t = useTranslations(Astro.currentLocale);

const contributions = await getGithubContributions('colinlienard');
const contributionsLabel = `${contributions.total.toLocaleString(Astro.currentLocale)} ${t('hero.contributions')}`;
---

<section id="hero" class="section relative flex flex-col gap-12">
	<h1 class="font-newsreader mt-8 text-2xl tracking-tight text-balance italic">Colin Lienard</h1>

	<div class="text-muted/90 flex flex-col gap-4 leading-relaxed text-pretty">
		<p>
			{t('hero.p1.pre')}<strong class="text-fg whitespace-nowrap">{t('hero.p1.role')}</strong>{
				t('hero.p1.mid1')
			}<strong class="text-fg">{t('hero.p1.city')}</strong>{t('hero.p1.mid2')}<strong
				class="text-fg">{t('hero.p1.remote')}</strong
			>{t('hero.p1.post')}
		</p>
		<p>
			{t('hero.p2.pre')}<strong class="text-fg">{t('hero.p2.link')}</strong>{
				t('hero.p2.mid1')
			}<strong class="text-fg whitespace-nowrap">front-end</strong>{t('hero.p2.mid2')}<strong
				class="text-fg whitespace-nowrap">back-end</strong
			>{t('hero.p2.post')}
		</p>
		<p>
			{t('hero.p3.pre')}<strong class="text-fg">
				{t('hero.p3.link')}
			</strong>
			{t('hero.p3.post')}
		</p>
	</div>

	<div class="flex items-center gap-2">
		<CopyEmailButton />
		<Contacts
			client:load
			{contributions}
			{contributionsLabel}
			labels={{
				linkedinHeadline: t('contact.linkedin.headline'),
				linkedinLocation: t('contact.linkedin.location'),
				linkedinCta: t('contact.linkedin.cta'),
				maltAvailability: t('contact.malt.availability'),
				maltRate: t('contact.malt.rate'),
				maltLocation: t('contact.malt.location'),
				xCta: t('contact.x.cta'),
			}}
		>
			<Image src={me} alt="Colin Lienard" width={80} height={80} class="size-10" />
		</Contacts>
	</div>
</section>
