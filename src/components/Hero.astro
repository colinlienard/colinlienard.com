---
import GithubIcon from 'virtual:icons/logos/github-icon';
import LinkedinIcon from 'virtual:icons/logos/linkedin-icon';
import XIcon from 'virtual:icons/logos/x';
import MaltIcon from '../assets/malt.svg';
import { CONTACT } from '../config';
import { useTranslations } from '../i18n';
import CopyEmailButton from './CopyEmailButton.astro';

const t = useTranslations(Astro.currentLocale);
---

<section id="hero" class="section relative flex flex-col gap-12">
	<h1 class="font-newsreader mt-8 text-2xl tracking-tight text-balance italic">Colin Lienard</h1>

	<div class="text-muted/90 flex flex-col gap-4 leading-relaxed text-pretty">
		<p>
			{t('hero.p1.pre')}<strong class="text-fg whitespace-nowrap">{t('hero.p1.role')}</strong>{
				t('hero.p1.mid1')
			}<strong class="text-fg">{t('hero.p1.city')}</strong>{t('hero.p1.mid2')}<strong
				class="text-fg">{t('hero.p1.remote')}</strong
			>{t('hero.p1.post')}
		</p>
		<p>
			{t('hero.p2.pre')}<strong class="text-fg">{t('hero.p2.link')}</strong>{
				t('hero.p2.mid1')
			}<strong class="text-fg whitespace-nowrap">front-end</strong>{t('hero.p2.mid2')}<strong
				class="text-fg whitespace-nowrap">back-end</strong
			>{t('hero.p2.post')}
		</p>
		<p>
			{t('hero.p3.pre')}<strong class="text-fg">
				{t('hero.p3.link')}
			</strong>
			{t('hero.p3.post')}
		</p>
	</div>

	<div class="flex flex-wrap items-center gap-4">
		<CopyEmailButton />
		<a href={CONTACT.github} target="_blank" rel="noopener noreferrer" aria-label="Github">
			<GithubIcon
				class="hover:[&_path]:fill-fg [&_path]:fill-muted size-6 [&_path]:transition-colors"
			/>
		</a>
		<a href={CONTACT.linkedin} target="_blank" rel="noopener noreferrer" aria-label="Linkedin">
			<LinkedinIcon
				class="hover:[&_path]:fill-fg [&_path]:fill-muted size-6 [&_path]:transition-colors"
			/>
		</a>
		<a href={CONTACT.malt} target="_blank" rel="noopener noreferrer" aria-label="Malt">
			<MaltIcon
				class="hover:[&_path]:fill-fg [&_path]:fill-muted size-6 [&_path]:transition-colors"
			/>
		</a>
		<a href={CONTACT.x} target="_blank" rel="noopener noreferrer" aria-label="X (Twitter)">
			<XIcon class="hover:[&_path]:fill-fg [&_path]:fill-muted size-6 [&_path]:transition-colors" />
		</a>
	</div>
</section>
