---
import { CONTACT } from '../config';
import { useTranslations } from '../i18n';

const t = useTranslations(Astro.currentLocale);

const link =
	'text-neutral-900 underline decoration-neutral-400 underline-offset-2 hover:decoration-solid decoration-dashed';
---

<section class="section relative flex flex-col gap-6">
	<h1 class="font-newsreader mt-8 text-2xl tracking-tight text-balance italic">Colin Lienard</h1>

	<div class="flex flex-col gap-4 leading-relaxed text-pretty text-neutral-500/90">
		<p>
			{t('hero.p1.pre')}<span class="whitespace-nowrap text-neutral-900">{t('hero.p1.role')}</span>{
				t('hero.p1.mid1')
			}<span class="text-neutral-900">{t('hero.p1.city')}</span>{t('hero.p1.mid2')}<span
				class="whitespace-nowrap text-neutral-900">{t('hero.p1.remote')}</span
			>{t('hero.p1.post')}
		</p>
		<p>
			{t('hero.p2.pre')}<a class={link} href="#experience">{t('hero.p2.link')}</a>{
				t('hero.p2.mid1')
			}<span class="whitespace-nowrap text-neutral-900">front-end</span>{t('hero.p2.mid2')}<span
				class="whitespace-nowrap text-neutral-900">back-end</span
			>{t('hero.p2.post')}
		</p>
		<p>
			{t('hero.p3.pre')}<a class={`${link} whitespace-nowrap`} href="#projects">
				{t('hero.p3.link')}
			</a>
			{t('hero.p3.post')}
		</p>
	</div>

	<div class="flex flex-wrap gap-2">
		<a
			class="flex rounded-full bg-neutral-900 px-4 py-2 text-white transition-all hover:bg-neutral-800 active:scale-95"
			href={CONTACT.cal}
		>
			Planifier un appel
		</a>
		<button
			type="button"
			id="copy-email"
			data-email={CONTACT.email}
			class="copy-email grid rounded-full bg-neutral-200/50 px-4 py-2 transition-all hover:bg-neutral-200 active:scale-95"
		>
			<span class="copy-label copy-label-default">{t('hero.cta.secondary')}</span>
			<span class="copy-label copy-label-copied" aria-hidden="true">{t('hero.cta.copied')}</span>
		</button>
	</div>
</section>

<script>
	const button = document.querySelector('#copy-email');

	if (button instanceof HTMLButtonElement) {
		const { email } = button.dataset;
		let timeout: ReturnType<typeof setTimeout>;

		button.addEventListener('click', async () => {
			if (!email) return;

			try {
				await navigator.clipboard.writeText(email);
				button.dataset.copied = 'true';
				clearTimeout(timeout);
				timeout = setTimeout(() => {
					delete button.dataset.copied;
				}, 3000);
			} catch {
				location.assign(`mailto:${email}`);
			}
		});
	}
</script>

<style>
	.copy-label {
		grid-area: 1 / 1;
		transition:
			opacity 0.5s ease,
			filter 0.5s ease;
	}

	.copy-label-copied {
		opacity: 0;
		filter: blur(4px);
	}

	.copy-email[data-copied] .copy-label-default {
		opacity: 0;
		filter: blur(4px);
	}

	.copy-email[data-copied] .copy-label-copied {
		opacity: 1;
		filter: blur(0);
	}

	.ping {
		animation: ping 1.5s cubic-bezier(0, 0, 0.2, 1) infinite;
	}

	@keyframes ping {
		90%,
		100% {
			transform: scale(3);
			opacity: 0;
		}
	}
</style>
