---
import { Image } from 'astro:assets';
import me from '../assets/me.jpeg';
import { useTranslations } from '../i18n';

const t = useTranslations(Astro.currentLocale);
---

<section class="section relative flex flex-col items-center justify-center text-center">
	<div class="flex items-center gap-2 rounded-full border border-taupe-900/10 px-4 py-2">
		<div class="relative size-2 *:absolute *:inset-0 *:rounded-full *:bg-green-400">
			<div></div>
			<div class="ping"></div>
		</div>
		<span class="font-mono text-sm">
			{t('hero.status')}
		</span>
	</div>

	<h1 class="mt-8 text-3xl font-medium tracking-tight text-balance sm:text-4xl">
		{t('hero.title')}
		<span class="block text-taupe-900/50">{t('hero.subtitle')}</span>
	</h1>

	<div class="mt-10 flex flex-wrap items-center justify-center gap-3">
		<a
			class="squircle flex items-center gap-3 bg-taupe-900 px-4 py-3 font-semibold text-white shadow-xl/30 transition-all duration-300 hover:shadow-xl/45 active:scale-95"
			href="https://cal.com/colinlienard/30min"
		>
			<Image
				src={me}
				alt="Colin Lienard"
				width={64}
				height={64}
				class="size-6 rounded-full object-cover"
				loading="eager"
			/>
			{t('hero.cta.primary')}
		</a>
		<button
			type="button"
			id="copy-email"
			data-email="hello@colinlienard.com"
			class="copy-email squircle grid place-items-center bg-taupe-900/8 px-4 py-3 font-semibold transition-all hover:bg-taupe-900/12 active:scale-95"
		>
			<span class="copy-label copy-label-default">{t('hero.cta.secondary')}</span>
			<span class="copy-label copy-label-copied" aria-hidden="true">{t('hero.cta.copied')}</span>
		</button>
	</div>
</section>

<script>
	const button = document.querySelector('#copy-email');

	if (button instanceof HTMLButtonElement) {
		const { email } = button.dataset;
		let timeout: ReturnType<typeof setTimeout>;

		button.addEventListener('click', async () => {
			if (!email) return;

			try {
				await navigator.clipboard.writeText(email);
				button.dataset.copied = 'true';
				clearTimeout(timeout);
				timeout = setTimeout(() => {
					delete button.dataset.copied;
				}, 3000);
			} catch {
				location.assign(`mailto:${email}`);
			}
		});
	}
</script>

<style>
	.copy-label {
		grid-area: 1 / 1;
		transition:
			opacity 0.5s ease,
			filter 0.5s ease;
	}

	.copy-label-copied {
		opacity: 0;
		filter: blur(4px);
	}

	.copy-email[data-copied] .copy-label-default {
		opacity: 0;
		filter: blur(4px);
	}

	.copy-email[data-copied] .copy-label-copied {
		opacity: 1;
		filter: blur(0);
	}

	.ping {
		animation: ping 1.5s cubic-bezier(0, 0, 0.2, 1) infinite;
	}

	@keyframes ping {
		90%,
		100% {
			transform: scale(3);
			opacity: 0;
		}
	}
</style>
