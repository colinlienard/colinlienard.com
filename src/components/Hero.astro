---
import CheckIcon from 'virtual:icons/heroicons/check';
import GithubIcon from 'virtual:icons/logos/github-icon';
import LinkedinIcon from 'virtual:icons/logos/linkedin-icon';
import XIcon from 'virtual:icons/logos/x';
import MaltIcon from '../assets/malt.svg';
import { CONTACT } from '../config';
import { useTranslations } from '../i18n';

const t = useTranslations(Astro.currentLocale);
---

<section id="hero" class="section relative flex flex-col gap-12">
	<h1 class="font-newsreader mt-8 text-2xl tracking-tight text-balance italic">Colin Lienard</h1>

	<div class="flex flex-col gap-4 leading-relaxed text-pretty text-neutral-500/90">
		<p>
			{t('hero.p1.pre')}<strong class="whitespace-nowrap text-neutral-900"
				>{t('hero.p1.role')}</strong
			>{t('hero.p1.mid1')}<strong class="text-neutral-900">{t('hero.p1.city')}</strong>{
				t('hero.p1.mid2')
			}<strong class="text-neutral-900">{t('hero.p1.remote')}</strong>{t('hero.p1.post')}
		</p>
		<p>
			{t('hero.p2.pre')}<strong class="text-neutral-900">{t('hero.p2.link')}</strong>{
				t('hero.p2.mid1')
			}<strong class="whitespace-nowrap text-neutral-900">front-end</strong>{
				t('hero.p2.mid2')
			}<strong class="whitespace-nowrap text-neutral-900">back-end</strong>{t('hero.p2.post')}
		</p>
		<p>
			{t('hero.p3.pre')}<strong class="text-neutral-900">
				{t('hero.p3.link')}
			</strong>
			{t('hero.p3.post')}
		</p>
	</div>

	<div class="flex flex-wrap items-center gap-4">
		<button
			type="button"
			id="copy-email"
			data-email={CONTACT.email}
			class="copy-email grid rounded-full bg-neutral-900 px-4 py-2 text-white transition-all hover:bg-neutral-800 active:scale-95"
		>
			<span class="copy-label copy-label-default">{t('hero.cta.secondary')}</span>
			<span class="copy-label copy-label-copied flex items-center gap-1" aria-hidden="true">
				<CheckIcon class="size-4" />
				{t('hero.cta.copied')}
			</span>
		</button>
		<a href={CONTACT.github} target="_blank" rel="noopener noreferrer">
			<GithubIcon
				class="size-6 [&_path]:transition-colors not-hover:[&_path]:fill-neutral-500"
				aria-label="Github"
			/>
		</a>
		<a href={CONTACT.linkedin} target="_blank" rel="noopener noreferrer">
			<LinkedinIcon
				class="size-6 [&_path]:transition-colors not-hover:[&_path]:fill-neutral-500"
				aria-label="Linkedin"
			/>
		</a>
		<a href={CONTACT.malt} target="_blank" rel="noopener noreferrer">
			<MaltIcon
				class="size-6 [&_path]:transition-colors not-hover:[&_path]:fill-neutral-500"
				aria-label="Malt"
			/>
		</a>
		<a href={CONTACT.x} target="_blank" rel="noopener noreferrer">
			<XIcon
				class="size-6 [&_path]:transition-colors not-hover:[&_path]:fill-neutral-500"
				aria-label="X"
			/>
		</a>
	</div>
</section>

<script>
	const button = document.querySelector('#copy-email');

	if (button instanceof HTMLButtonElement) {
		const { email } = button.dataset;
		let timeout: ReturnType<typeof setTimeout>;

		button.addEventListener('click', async () => {
			if (!email) return;

			try {
				await navigator.clipboard.writeText(email);
				button.dataset.copied = 'true';
				clearTimeout(timeout);
				timeout = setTimeout(() => {
					delete button.dataset.copied;
				}, 3000);
			} catch {
				location.assign(`mailto:${email}`);
			}
		});
	}
</script>

<style>
	.copy-label {
		grid-area: 1 / 1;
		transition:
			opacity 0.5s ease,
			filter 0.5s ease;
	}

	.copy-label-copied {
		opacity: 0;
		filter: blur(4px);
	}

	.copy-email[data-copied] .copy-label-default {
		opacity: 0;
		filter: blur(4px);
	}

	.copy-email[data-copied] .copy-label-copied {
		opacity: 1;
		filter: blur(0);
	}

	.ping {
		animation: ping 1.5s cubic-bezier(0, 0, 0.2, 1) infinite;
	}

	@keyframes ping {
		90%,
		100% {
			transform: scale(3);
			opacity: 0;
		}
	}
</style>
